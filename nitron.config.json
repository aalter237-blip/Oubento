{
  "name": "Oubento",
  "packageId": "os.oubento",
  "version": "24.04.3",
  "entry": "www/index.html",
  "orientation": "portrait",
  "statusBar": false,
  "permissions": [
    "INTERNET",
    "ACCESS_NETWORK_STATE",
    "CAMERA",
    "RECORD_AUDIO",
    "ACCESS_FINE_LOCATION",
    "ACCESS_COARSE_LOCATION",
    "MODIFY_AUDIO_SETTINGS"
  ],
  "icon": "www/assets/branding/icon-512.png",
  "network": {
    "cleartext": true
  },
  "webview": {
    "backButton": "history",
    "clearCacheOnStart": false
  },
  "splashScreen": {
    "backgroundColor": "#1a0b14"
  }
}
